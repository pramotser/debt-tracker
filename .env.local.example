# Supabase Postgres — รอบนี้ยังไม่ใช้ ตอนต่อค่อยก็อปเป็น .env.local
# runtime: transaction pooler 6543 (pgbouncer=true)
DATABASE_URL="postgres://USER:PASS@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# migrate: session pooler 5432
DATABASE_URL_MIGRATE="postgres://USER:PASS@aws-0-REGION.pooler.supabase.com:5432/postgres"
